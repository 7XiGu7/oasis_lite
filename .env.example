# LLM backend for profile simulations and smoke API checks.
BACKEND=dashscope
MODEL_NAME=qwen-plus

# DashScope OpenAI-compatible endpoint.
DASHSCOPE_API_KEY=replace-with-your-dashscope-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL_NAME=qwen-plus

# OpenAI-compatible fallback.
OPENAI_API_KEY=replace-with-your-openai-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Set false for remote APIs. Set true only when intentionally using local vLLM.
IS_VLLM=false

# Optional runtime paths. The examples also accept command-line overrides.
OASIS_DB_PATH=outputs/oasis_lite.db
OASIS_ENV_LOG_PATH=outputs/logs/oasis-env.log
OASIS_PLATFORM_LOG_PATH=outputs/logs/social-platform.log
OASIS_LLM_USAGE_LOG_PATH=outputs/logs/llm-usage-summary.json

# Optional only for examples/light_api_experiment.py --agent-variant recagent_user.
EMBEDDING_MODEL=/data/lijiantong/Downloads/bge-m3_ms
